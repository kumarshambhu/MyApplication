<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />

    <style name="NavigationViewTextStyle" parent="Base.TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/gold</item>
        <item name="android:textSize">25sp</item>
    </style>


    <style name="LoshuGridCellStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:outlineSpotShadowColor">@color/gold</item>
        <item name="android:outlineAmbientShadowColor">@color/gold</item>
        <item name="android:background">@drawable/grid_border</item>
    </style>


    <!-- ========== CARD THEMES ========== -->
    <!-- Primary Card Text Styles -->
    <style name="Theme.YourApp.Card.Primary" parent="">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="elevation">5dp</item>
        <item name="cardCornerRadius">0dp</item>
    </style>

    <style name="Theme.YourApp.CardText.Primary.Header" parent="">
        <item name="android:textColor">@color/card_header</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
    </style>


    <style name="Theme.YourApp.CardText.Primary.Subheader" parent="">
        <item name="android:textColor">@color/card_sub_header</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Theme.YourApp.CardText.Primary.Content" parent="">
        <item name="android:textColor">@color/card_content</item>
        <item name="android:textSize">20sp</item>
    </style>


    <!-- Primary Pill Tabs -->
    <style name="TabTextAppearance.Pill.Primary" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center</item>
    </style>

</resources>