<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/mystical_gradient_background"
    tools:context=".fragment.secondary_number.LuckyNumberFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/luckyNumberTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Lucky and Unlucky Numbers"
            android:textAlignment="center"
            android:textColor="@color/gold"
            android:textSize="28sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/luckyNumberLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Lucky Numbers:"
            android:textColor="@color/gold"
            app:layout_constraintTop_toBottomOf="@id/luckyNumberTitle"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="32dp"/>

        <LinearLayout
            android:id="@+id/luckyNumbersContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/luckyNumberLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/unluckyNumbersLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unlucky Numbers (Karmic Debt):"
            android:textColor="@color/gold"
            app:layout_constraintTop_toBottomOf="@id/luckyNumbersContainer"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/unluckyNumbersValueTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/unluckyNumbersLabel"
            android:layout_marginTop="8dp"
            tools:text="13, 14, 16, 19"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/unluckyNumbersValueTextView1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/unluckyNumbersValueTextView"
            android:layout_marginTop="8dp"
            tools:text="13, 14, 16, 19"
            tools:ignore="MissingConstraints" />



    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
