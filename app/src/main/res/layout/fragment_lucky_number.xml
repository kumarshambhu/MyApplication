<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".fragment.secondary_number.LuckyNumberFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/luckyNumberTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/mystical_font"
            android:gravity="center"
            android:text="Lucky and Unlucky Numbers"
            android:textAlignment="center"
            android:textColor="@color/gold"
            android:textSize="28sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/luckyNumberLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Lucky Number:"
            android:textColor="@color/gold"
            android:textSize="18sp"
            app:layout_constraintTop_toBottomOf="@id/luckyNumberTitle"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="32dp"/>

        <TextView
            android:id="@+id/luckyNumberValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mystical_font"
            android:textColor="@color/white"
            android:textSize="24sp"
            app:layout_constraintTop_toTopOf="@id/luckyNumberLabel"
            app:layout_constraintBottom_toBottomOf="@id/luckyNumberLabel"
            app:layout_constraintStart_toEndOf="@id/luckyNumberLabel"
            android:layout_marginStart="8dp"
            tools:text="7"/>

        <TextView
            android:id="@+id/unluckyNumbersLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unlucky Numbers (Karmic Debt):"
            android:textColor="@color/gold"
            android:textSize="18sp"
            app:layout_constraintTop_toBottomOf="@id/luckyNumberLabel"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/unluckyNumbersValueTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mystical_font"
            android:textColor="@color/white"
            android:textSize="24sp"
            app:layout_constraintTop_toBottomOf="@id/unluckyNumbersLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            tools:text="13, 14, 16, 19"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
