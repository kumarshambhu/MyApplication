<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mystical_gradient_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/personalMonthColumn"
            android:layout_width="0dp"
            android:layout_height="60dp"

            android:gravity="center"
            android:padding="8dp"
            android:text="@string/personal_month"
            android:textColor="@color/gold"
            android:textSize="28sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.8"
            tools:ignore="MissingConstraints" />

        <!-- Group of 3 views to the right of Col 1 -->
        <TextView
            android:id="@+id/tvPersonalMonth"
            android:layout_width="0dp"
            android:layout_height="60dp"

            android:padding="8dp"
            android:text="0"
            android:textColor="@color/gold"
            android:textSize="28sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/personalMonthColumn"
            tools:ignore="MissingConstraints" />

        <!-- Third Row -->
        <TextView
            android:id="@+id/tvPersonalMonthInterpretation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:padding="16dp"
            android:text="@string/interpretation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPersonalMonth" />

        <View
            android:id="@+id/personalYearViewLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp"
            android:background="@color/gold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPersonalMonthInterpretation"
            tools:ignore="MissingConstraints" />

        <!-- Group of 3 views to the right of Col 1 -->
        <TextView
            android:id="@+id/column1"
            android:layout_width="0dp"
            android:layout_height="60dp"

            android:gravity="center"
            android:padding="8dp"
            android:text="@string/personal_year"
            android:textColor="@color/gold"
            android:textSize="28sp"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/personalYearViewLine"
            app:layout_constraintWidth_percent="0.8"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/tvPersonalYear"
            android:layout_width="0dp"
            android:layout_height="60dp"

            android:padding="8dp"
            android:text="0"
            android:textColor="@color/gold"
            android:textSize="28sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/column1"
            app:layout_constraintTop_toBottomOf="@id/personalYearViewLine"
            tools:ignore="MissingConstraints" />

        <!-- Third Row -->
        <TextView
            android:id="@+id/tvPersonalYearInterpretation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/interpretation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/column1" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
