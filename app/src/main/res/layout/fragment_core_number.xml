<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="0dp"
    tools:ignore="ScrollViewCount">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/content_birth_number"
            android:visibility="gone"
            layout="@layout/custom_core_number_design" />

        <include
            android:id="@+id/content_lifepath_number"
            android:visibility="gone"
            layout="@layout/custom_core_number_design" />

        <include
            android:id="@+id/content_soul_number"
            android:visibility="gone"
            layout="@layout/custom_core_number_design" />

        <include
            android:id="@+id/content_personality_number"
            android:visibility="gone"
            layout="@layout/custom_core_number_design" />

        <include
            android:id="@+id/content_destiny_number"
            android:visibility="gone"
            layout="@layout/custom_core_number_design" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/coreNumberRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


        <include
            android:id="@+id/content_combination_layout"
            layout="@layout/custom_combination_layout" />

    </LinearLayout>

</ScrollView>