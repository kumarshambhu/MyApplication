<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Theme.YourApp.Card.Primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            tools:ignore="UseCompoundDrawables">

            <TextView
                android:id="@+id/tvKarmicDebtNumber"
                style="@style/Theme.YourApp.CardText.Primary.Header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_number"
                 />

            <ImageView
                android:id="@+id/ivExpand"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_arrow_down" />

        </LinearLayout>

        <!-- Content -->
        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/tvKarmicDebtSource"
                style="@style/Theme.YourApp.CardText.Primary.Subheader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/interpretation" />

            <!-- Challenges Section -->
            <TextView
                android:id="@+id/challengesTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Challenges and Problems"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white_60"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/challengesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="8dp"/>

            <!-- Qualities Section -->
            <TextView
                android:id="@+id/qualitiesTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Qualities"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white_60"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/qualitiesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="8dp"/>

            <!-- Keys to Overcome Section -->
            <TextView
                android:id="@+id/keysTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keys to Overcome"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white_60"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/keysToOvercomeRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="8dp"/>

            <!-- Potential Outcome Section -->
            <TextView
                android:id="@+id/outcomeTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Potential Outcome"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white_60"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:visibility="visible"/>

            <TextView
                android:id="@+id/outcomeTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/white_60"
                android:layout_marginBottom="16dp"
                android:visibility="visible"/>

            <!-- Summary Section -->
            <TextView
                android:id="@+id/summaryTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Summary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white_60"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/summaryTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/white_60"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp"/>


        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>