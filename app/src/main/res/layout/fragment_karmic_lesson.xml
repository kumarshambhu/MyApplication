<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@drawable/mystical_gradient_background"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvKarmicByNameLabel"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:padding="8dp"
            android:text="Karmic Lesson"
            android:textColor="@color/gold"
            android:fontFamily="@font/mystical_font"
            android:textSize="28sp"
            android:gravity="end"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.8" />

        <TextView
            android:id="@+id/tvKarmicByNameValue"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:padding="8dp"
            android:text="0"
            android:textColor="@color/gold"
            android:fontFamily="@font/mystical_font"
            android:textSize="28sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvKarmicByNameLabel" />

        <TextView
            android:id="@+id/karmic_by_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/tvKarmicByNameValue"
            app:layout_constraintStart_toStartOf="parent"
            android:padding="16dp"
            android:fontFamily="@font/mystical_font"
            android:textColor="@color/white"
            android:text="@string/interpretation"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
