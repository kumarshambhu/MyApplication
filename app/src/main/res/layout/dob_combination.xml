<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/accordionCard"
    style="@style/AccordionCardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/combinationHeaderLayout"
            style="@style/AccordionHeaderStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_grid"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/topHeader"
                style="@style/AccordionTitleStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Combination Analysis" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFamily="@font/mystical_font"
                android:textColor="@color/gold"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="1 &amp; 1" />

            <ImageView
                android:id="@+id/combinationExpandableIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_down"
                app:tint="@color/secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/combinationContentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvRuler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:textColor="@color/secondary"
                android:textSize="14sp"
                tools:text="Ruled by Sun" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/combinationDetailsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>