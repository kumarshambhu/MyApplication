<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@drawable/mystical_gradient_background"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvBirthdayNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Birthday Number: "
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvLifePathNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Life Path Number: "
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvKuaNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kua Number: "
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvLoShuGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lo Shu Grid: "
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvMissingNumbers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Missing Numbers: "
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvMobileSum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mobile Sum: "
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvMobilePairs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mobile Pairs: "
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvPairAnalysis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pair Analysis: "
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvResults"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>