<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/mystical_gradient_background"
    tools:context=".MainActivity">

    <!-- App Bar -->
    <androidx.appcompat.widget.Toolbar
        android="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/mystical_gradient"
        android:elevation="4dp"
        app:title="Enter Your Personal Details" />

    <!-- Hero Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Birth Details"
            android:textSize="24sp"
            android:textColor="@color/gold"
            android:fontFamily="@font/mystical_font"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"/>

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/mystical_symbol"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"/>
    </LinearLayout>

    <!-- Input Fields -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Full Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_person"
                android:layout_gravity="center_vertical"/>

            <EditText
                android:id="@+id/nameEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Full Name"
                android:inputType="textPersonName"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textColorHint="@color/white"
                android:background="@drawable/mystical_input_field"
                android:padding="16dp"
                android:fontFamily="@font/mystical_font"/>
        </LinearLayout>

        <!-- Date of Birth -->
        <LinearLayout
            android:id="@+id/dobLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_calendar"
                android:layout_gravity="center_vertical"/>

            <TextView
                android:id="@+id/dobTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="20sp"
                android:text="Date of Birth (DD/MM/YYYY)"
                android:textColor="@color/white"
                android:background="@drawable/mystical_input_field"
                android:padding="16dp"
                android:fontFamily="@font/mystical_font"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/genderLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/outline_agender_24"
                android:layout_gravity="center_vertical"/>
        <!-- Gender -->
        <RadioGroup
            android:id="@+id/genderRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:textSize="20sp"
            android:layout_marginTop="0sp"
            android:layout_marginBottom="0dp">

            <RadioButton
                android:id="@+id/maleRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Male"
                android:paddingEnd="25sp"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:fontFamily="@font/mystical_font"/>

            <RadioButton
                android:id="@+id/femaleRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Female"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:fontFamily="@font/mystical_font"/>
        </RadioGroup>
        </LinearLayout>
        <!-- Time of Birth -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_clock"
                android:layout_gravity="center_vertical"/>

            <EditText
                android:id="@+id/timeEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Time of Birth (HH:MM)"
                android:inputType="time"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textSize="20sp"
                android:background="@drawable/mystical_input_field"
                android:padding="16dp"
                android:fontFamily="@font/mystical_font"/>
        </LinearLayout>

        <!-- Location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_map_marker"
                android:layout_gravity="center_vertical"/>

            <EditText
                android:id="@+id/locationEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Location"
                android:textSize="20sp"
                android:inputType="text"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:background="@drawable/mystical_input_field"
                android:padding="16dp"
                android:fontFamily="@font/mystical_font"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Action Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <Button
            android:id="@+id/calculateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculate My Numbers"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:background="@drawable/mystical_button"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/mystical_font"/>

        <Button
            android:id="@+id/predictionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Predictions"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:background="@drawable/mystical_button"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/mystical_font"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your birth details are sacred"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:layout_marginTop="0dp"/>
    </LinearLayout>

    <!-- Floating mystical elements -->
    <!-- Add ImageViews for floating orbs and symbols -->
</LinearLayout>
