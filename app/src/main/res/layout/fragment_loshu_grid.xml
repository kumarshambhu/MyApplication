<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/mystical_gradient_background"
    tools:context=".fragment.core_number.LoshuGridFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/mystical_font"
            android:text="Loshu Grid"
            android:textColor="@color/primary"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_loshu_grid"
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintWidth_percent="0.95">

            <GridLayout
                android:id="@+id/loshu_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:padding="8dp"
                android:rowCount="3">

                <TextView
                    android:id="@+id/cell_4"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="4" />

                <TextView
                    android:id="@+id/cell_9"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="9" />

                <TextView
                    android:id="@+id/cell_2"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="2" />

                <TextView
                    android:id="@+id/cell_3"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="3" />

                <TextView
                    android:id="@+id/cell_5"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="5" />

                <TextView
                    android:id="@+id/cell_7"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="7" />

                <TextView
                    android:id="@+id/cell_8"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="8" />

                <TextView
                    android:id="@+id/cell_1"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="1" />

                <TextView
                    android:id="@+id/cell_6"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="6" />
            </GridLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_loshu_grid_element"
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_loshu_grid"
            app:layout_constraintWidth_percent="0.95">

            <GridLayout
                android:id="@+id/loshu_grid_element"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:padding="8dp"
                android:rowCount="3">

                <TextView
                    android:id="@+id/cell_element_4"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="4\nWood" />

                <TextView
                    android:id="@+id/cell_element_9"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="9\nFire" />

                <TextView
                    android:id="@+id/cell_element_2"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="2\nEarth" />

                <TextView
                    android:id="@+id/cell_element_3"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="3\nWood" />

                <TextView
                    android:id="@+id/cell_element_5"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="5\nEarth" />

                <TextView
                    android:id="@+id/cell_element_7"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="7\nSilver" />

                <TextView
                    android:id="@+id/cell_element_8"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="8\nEarth" />

                <TextView
                    android:id="@+id/cell_element_1"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="1\nWater" />

                <TextView
                    android:id="@+id/cell_element_6"
                    style="@style/LoshuGridCellStyle"
                    android:layout_margin="4dp"
                    android:text="6\nGold" />
            </GridLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_summary"
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_loshu_grid_element"
            app:layout_constraintWidth_percent="0.95">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/loshu_grid_dob_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mystical_font"
                    android:text="Date of Birth:"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/loshu_grid_dob_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/mystical_font"
                    android:textColor="@color/secondary"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="@id/loshu_grid_dob_label"
                    app:layout_constraintStart_toEndOf="@id/loshu_grid_dob_label"
                    app:layout_constraintTop_toTopOf="@id/loshu_grid_dob_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/loshu_grid_dob_label">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/loshu_grid_mulank_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mystical_font"
                            android:text="Mulank"
                            android:textColor="@color/primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/loshuGridMulankValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mystical_font"
                            android:text="00"
                            android:textColor="@color/secondary"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/loshu_grid_bhagyank_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mystical_font"
                            android:text="Bhagyank"
                            android:textColor="@color/primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/loshu_grid_bhagyank_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mystical_font"
                            android:text="00"
                            android:textColor="@color/secondary"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/loshu_grid_kua_number_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mystical_font"
                            android:text="Kua"
                            android:textColor="@color/primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/loshuGridKuaNumberValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mystical_font"
                            android:text="0000"
                            android:textColor="@color/secondary"
                            android:textSize="20sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/planeRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_summary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/missingNumberRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/planeRecyclerView" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/repeatNumberRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/missingNumberRecyclerView" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
