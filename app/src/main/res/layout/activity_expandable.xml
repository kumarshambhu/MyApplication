<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/dark_test"
    tools:context=".ExpandableActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2A2B37"
            android:minHeight="70dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                app:titleTextColor="@color/gold"
                android:layout_height="?attr/actionBarSize" />

        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:background="@color/dark_test"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ExpandableTextView Examples"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <!-- Example 1: Basic Usage -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Basic Usage"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <com.shambhu.myapplication.utils.ExpandableTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:textColor="@color/dark_text"
                    android:text="@string/sample_text_medium"
                    android:textSize="14sp" />

                <!-- Example 2: Custom Max Lines -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. Custom Max Lines (2 lines)"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <com.shambhu.myapplication.utils.ExpandableTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:text="@string/sample_text_long"
                    android:textSize="14sp"
                    app:collapsedMaxLines="2"
                    app:showMoreText="Read more"
                    app:showLessText="Read less" />

                <!-- Example 3: Long Text with Animation -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. Long Text with Custom Animation"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <com.shambhu.myapplication.utils.ExpandableTextView
                    android:id="@+id/expandableText3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:text="@string/sample_text_very_long"
                    android:textSize="14sp"
                    app:collapsedMaxLines="4"
                    app:animationDuration="500"
                    app:showMoreText="Expand ↑"
                    app:showLessText="Collapse ↓" />

                <!-- Example 4: Short Text (No toggle needed) -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. Short Text (No toggle needed)"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <com.shambhu.myapplication.utils.ExpandableTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:text="@string/sample_text_short"
                    android:textSize="14sp" />

                <!-- Example 5: Custom Styling -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5. Custom Styling"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <com.shambhu.myapplication.utils.ExpandableTextView
                    android:id="@+id/expandableText5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:text="@string/sample_text_long"
                    android:textSize="16sp"
                    android:textColor="#2E7D32"
                    android:textStyle="italic"
                    app:collapsedMaxLines="3" />

                <Button
                    android:id="@+id/btnToggleAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toggle All"
                    android:layout_gravity="center" />

            </LinearLayout>

        </ScrollView>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_height="80dp"
            android:layout_width="match_parent"
            android:layout_gravity="bottom"
            android:layout_marginBottom="10dp"
            app:tabBackground="@drawable/tab_pill_primary_selector"
            android:background="@color/dark_tab_bg"
            app:tabGravity="center"
            app:tabMode="scrollable"
            app:tabRippleColor="?attr/colorOnPrimaryContainer"
            app:tabIndicatorColor="@android:color/transparent"
            app:tabIndicatorHeight="0dp"
            app:tabSelectedTextColor="?attr/colorOnPrimary"
            app:tabTextColor="?attr/colorOnSurfaceVariant"
            app:tabIconTint="@color/tab_pill_icon_tint_primary"
            app:tabTextAppearance="@style/TabTextAppearance.Pill.Primary"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/dark_tab"
        app:headerLayout="@layout/nav_header_main"
        app:iconTint="@android:color/transparent"
        app:itemTextColor="@color/dark_gold"
        app:itemIconSize="24dp"
        app:itemTextAppearance="@style/NavigationViewTextStyle"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
