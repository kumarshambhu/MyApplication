<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/holo_blue_bright" />
            <!-- Add padding to prevent content from touching borders -->
            <padding
                android:bottom="1dp"
                android:right="1dp" />
        </shape>
    </item>
    
    <!-- Bottom border -->
    <item android:bottom="-1dp"
          android:left="-1dp"
          android:right="-1dp"
          android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/holo_orange_dark" />
        </shape>
    </item>
    
    <!-- Right border -->
    <item android:right="-1dp"
          android:left="0dp"
          android:top="-1dp"
          android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/holo_orange_dark" />
        </shape>
    </item>
</layer-list>