<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>

    <!-- ========== CARD THEMES ========== -->
    <!-- Primary Card Text Styles -->
    <style name="Theme.MyApplication.CardPrimary" parent="">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="elevation">5dp</item>
        <item name="cardCornerRadius">0dp</item>
    </style>

    <style name="Theme.MyApplicationApp.CardText.Primary.Header" parent="">
        <item name="android:textColor">@color/card_header</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>


    <style name="Theme.MyApplicationApp.CardText.Primary.Subheader" parent="">
        <item name="android:textColor">@color/card_sub_header</item>
    </style>

    <style name="Theme.MyApplicationApp.CardText.Primary.Content" parent="">
        <item name="android:textColor">@color/card_content</item>
        <item name="android:textSize">20sp</item>
    </style>


    <style name="Theme.MyApplication.CardSecondary" parent="">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="elevation">5dp</item>
        <item name="cardCornerRadius">0dp</item>
    </style>

    <style name="Theme.MyApplicationApp.CardText.Secondary.Header" parent="">
        <item name="android:textColor">@color/card_header</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>


    <style name="Theme.MyApplicationApp.CardText.Secondary.Subheader" parent="">
        <item name="android:textColor">@color/card_sub_header</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.MyApplicationApp.CardText.Secondary.Content" parent="">
        <item name="android:textColor">@color/card_content</item>
        <item name="android:textSize">20sp</item>
    </style>

</resources>